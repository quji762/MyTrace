<Window x:Class="Pulse.App.RailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        Width="64" Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="Shell"
            Background="{DynamicResource RailBackground}"
            CornerRadius="28"
            Padding="10,22"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#28FFFFFF" Offset="0" />
                <GradientStop Color="#10FFFFFF" Offset="0.5" />
                <GradientStop Color="#18FFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Grid>
            <TextBlock x:Name="EmptyMark"
                       Text="Pulse"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.55"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <ScrollViewer x:Name="RingScroll"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Visibility="Collapsed">
                <StackPanel x:Name="RingHost" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
