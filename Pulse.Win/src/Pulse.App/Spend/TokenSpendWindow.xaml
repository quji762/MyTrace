<Window x:Class="Pulse.App.Spend.TokenSpendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse"
        Width="880" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsBackground}"
        Foreground="{DynamicResource RailForeground}"
        FontFamily="Segoe UI, Segoe UI Variable, Microsoft YaHei UI, sans-serif">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Pulse.App;component/Themes/PulseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource PulseButton}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource PulseTextBox}" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RailForeground}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="8,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                Padding="6,4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Token spend" FontSize="16" FontWeight="SemiBold"
                           Margin="16,20,16,4" />
                <TextBlock DockPanel.Dock="Top" Text="One row per source"
                           FontSize="12" Opacity="0.5" Margin="16,0,16,12" />
                <ListBox x:Name="SourceList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource RailForeground}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSourceChanged" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefresh" VerticalAlignment="Center" />
                <TextBlock Text="Local logs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Grid.Row="1" x:Name="SummaryText" FontSize="12" Opacity="0.85"
                       Margin="0,12,0,10" TextWrapping="Wrap" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="10,10,10,0">
                <Canvas x:Name="ChartCanvas" SizeChanged="OnChartResized" />
            </Border>

            <Grid Grid.Row="3" Margin="10,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Top models" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel x:Name="ModelBars" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Top projects" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel x:Name="ProjectBars" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="10,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Sessions" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListView Grid.Row="1" x:Name="SessionList" Background="Transparent"
                              BorderThickness="0" Foreground="{DynamicResource RailForeground}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Session" Width="280" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Project" Width="140" DisplayMemberBinding="{Binding Project}" />
                                <GridViewColumn Header="Tokens" Width="90" DisplayMemberBinding="{Binding TokensText}" />
                                <GridViewColumn Header="End" Width="140" DisplayMemberBinding="{Binding EndText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
