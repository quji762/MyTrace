<Window x:Class="Pulse.App.Spend.TokenSpendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse — Token Spend"
        Width="760" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: provider tabs + summary line -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ClaudeTab" Content="Claude Code" GroupName="spend" Margin="0,0,8,0"
                             Foreground="#FFF2F2F2" Checked="OnProviderTabChanged" />
                <RadioButton x:Name="CodexTab" Content="Codex" GroupName="spend" Margin="0,0,16,0"
                             Foreground="#FFF2F2F2" Checked="OnProviderTabChanged" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Padding="12,4" Click="OnRefresh" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SummaryText" FontSize="12" Foreground="#FFF2F2F2"
                   Margin="0,10,0,8" TextWrapping="Wrap" />

        <!-- Daily tokens chart: one bar per day, gaps kept as zero-height days -->
        <Border Grid.Row="2" Background="#FF2A2A2A" CornerRadius="6" Padding="8">
            <Canvas x:Name="ChartCanvas" SizeChanged="OnChartResized" />
        </Border>

        <!-- Session list: one row per transcript -->
        <Border Grid.Row="3" Background="#FF2A2A2A" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Sessions" FontSize="12" FontWeight="SemiBold"
                           Foreground="#FFF2F2F2" Margin="0,0,0,6" />
                <ListView Grid.Row="1" x:Name="SessionList" Background="Transparent"
                          BorderThickness="0" Foreground="#FFF2F2F2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Session" Width="300"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Project" Width="140"
                                            DisplayMemberBinding="{Binding Project}" />
                            <GridViewColumn Header="Tokens" Width="90"
                                            DisplayMemberBinding="{Binding TokensText}" />
                            <GridViewColumn Header="End" Width="140"
                                            DisplayMemberBinding="{Binding EndText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
