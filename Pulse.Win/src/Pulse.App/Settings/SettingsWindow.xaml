<Window x:Class="Pulse.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse Settings"
        Width="520" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Provider credentials" FontSize="16" FontWeight="SemiBold"
                   Foreground="#FFF2F2F2" Margin="0,0,0,8" />
        <TextBlock Grid.Row="0" Text="Keys are encrypted with DPAPI (current user) and never leave this machine."
                   FontSize="11" Foreground="#FF9E9E9E" Margin="0,22,0,10" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProviderList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF2A2A2A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           Foreground="#FFF2F2F2" />
                                <TextBox Grid.Column="1" Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0" VerticalContentAlignment="Center"
                                         Background="#FF181818" Foreground="#FFF2F2F2" BorderBrush="#FF3D3D3D" />
                                <Button Grid.Column="2" Content="Save" Padding="10,4"
                                        Click="OnSaveCredential" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Padding="14,5" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
