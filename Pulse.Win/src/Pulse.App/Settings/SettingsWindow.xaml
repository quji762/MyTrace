<Window x:Class="Pulse.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse Settings"
        Width="520" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Provider credentials" FontSize="16" FontWeight="SemiBold"
                       Foreground="#FFF2F2F2" />
            <TextBlock Text="Keys are encrypted with DPAPI (current user) and never leave this machine."
                       FontSize="11" Foreground="#FF9E9E9E" Margin="0,4,0,10" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="ProviderList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF2A2A2A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               Foreground="#FFF2F2F2" />
                                    <TextBox Grid.Column="1" Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="8,0" VerticalContentAlignment="Center"
                                             Background="#FF181818" Foreground="#FFF2F2F2" BorderBrush="#FF3D3D3D" />
                                    <Button Grid.Column="2" Content="Save" Padding="10,4"
                                            Click="OnSaveCredential" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Multiple accounts: claudeCode, codex, grok, grokBot only
                     (upstream supportsMultipleAccounts; a wider UI would promise
                     a behavior the credential model cannot deliver) -->
                <Border Background="#FF2A2A2A" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Additional accounts" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFF2F2F2" />
                        <TextBlock Text="Sign in to extra accounts with their own OAuth login. Never touches the CLI's own stored credential."
                                   FontSize="10" Foreground="#FF9E9E9E" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <ItemsControl x:Name="ExtraAccountList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center" Foreground="#FFF2F2F2" />
                                        <TextBlock Grid.Column="1" Text="{Binding AccountsSummary}"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="#FF9E9E9E" Margin="8,0" />
                                        <Button Grid.Column="2" Content="Add account" Padding="10,4"
                                                Click="OnAddAccount" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#FF2A2A2A" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <CheckBox x:Name="StartupToggle" Content="Launch Pulse at startup"
                              Foreground="#FFF2F2F2" Checked="OnStartupToggled" Unchecked="OnStartupToggled" />
                </Border>

                <Border Background="#FF2A2A2A" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Claude Code status line" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#FFF2F2F2" />
                                <TextBlock x:Name="StatusLineSummary" Text="" FontSize="10"
                                           Foreground="#FF9E9E9E" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="StatusLineButton" Grid.Column="1" Content="Enable" Padding="10,4"
                                    VerticalAlignment="Center" Click="OnStatusLineToggle" />
                        </Grid>
                        <TextBlock Text="Shows Pulse's per-account context usage inside Claude Code. Your existing status line is remembered and restored on disable."
                                   FontSize="10" Foreground="#FF9E9E9E" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Padding="14,5" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
